# Mobile OpenRig room — example environment configuration
# Copy to .env and fill in YOUR values. Never commit a real .env.

# ── OpenRig daemon (keep loopback!) ────────────────────────────
OPENRIG_HOST=127.0.0.1
OPENRIG_PORT=31455
# Which rig's seats join the room:
OPENRIG_RIG=first-project

# ── Room web UI ────────────────────────────────────────────────
# Local listener (same-machine browser access):
ROOM_HOST=127.0.0.1
ROOM_PORT=8800
# Optional: ONE private-network interface to also listen on
# (e.g. your tailscale0 / VPN interface address — never 0.0.0.0):
# ROOM_PRIVATE_HOST=100.x.y.z
# ROOM_PRIVATE_PORT=8800

# ── MCP bridge (controller-agent surface; keep loopback) ──────
MCP_HOST=127.0.0.1
MCP_PORT=8810

# ── Hermes bridge ──────────────────────────────────────────────
# Working directory for Hermes sessions (optional):
# HERMES_WORKDIR=/path/to/a/workspace

# ── Identity shown in the room ─────────────────────────────────
ROOM_HUMAN_ID=you
ROOM_HUMAN_NAME=You

# ── Runtime state location (optional override) ─────────────────
# ROOM_STATE_DB=/var/lib/somewhere/room-state.db
